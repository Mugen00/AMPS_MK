<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Over-the-air updates: install a release APK through the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        1.0.3, импорт музыки в библиотеку телефона.

        На Android 10+ запись своей музыки в общую папку Music через MediaStore
        разрешений не требует вообще — scoped storage разрешает это приложению
        напрямую. Поэтому WRITE_EXTERNAL_STORAGE ограничен maxSdkVersion=28:
        начиная с 29 permission там просто игнорируется, а объявлять его
        без ограничения — значит объяснять пользователю право, которого нет.

        READ_EXTERNAL_STORAGE (до 32) и READ_MEDIA_AUDIO (33+) нужны только для
        ЧТЕНИЯ уже существующей музыки устройства, чтобы искать по ней.
        MANAGE_EXTERNAL_STORAGE намеренно не запрашивается: это право уровня
        «видеть всё», а музыкальному приложению оно не нужно.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:name=".AmpsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AMPS">

        <!-- Shares only the `updates` folder of @xml/amps_file_paths with the installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/amps_file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AMPS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a screenshot straight from the gallery into AMPS -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
