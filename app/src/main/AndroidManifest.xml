<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Over-the-air updates: install a release APK through the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        1.0.3, импорт музыки в библиотеку телефона.

        На Android 10+ запись своей музыки в общую папку Music через MediaStore
        разрешений не требует вообще — scoped storage разрешает это приложению
        напрямую. Поэтому WRITE_EXTERNAL_STORAGE ограничен maxSdkVersion=28:
        начиная с 29 permission там просто игнорируется, а объявлять его
        без ограничения — значит объяснять пользователю право, которого нет.

        READ_EXTERNAL_STORAGE (до 32) и READ_MEDIA_AUDIO (33+) нужны только для
        ЧТЕНИЯ уже существующей музыки устройства, чтобы искать по ней.
        MANAGE_EXTERNAL_STORAGE намеренно не запрашивается: это право уровня
        «видеть всё», а музыкальному приложению оно не нужно.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
        1.1.2: сповіщення у шторці (Android 13+). Запитує екран Спільноти,
        поки користувач не погодиться — сповіщення просто не показуються.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        1.2.0: зйомка сторіс. Камера телефону викликається через системний
        застосунок камери (TakePicture/TakeVideo) — тому тут лише CAMERA;
        читання знімків чужих застосунків ми не просимо.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 1.2.0: Credential Manager знаходить постачальника облікових даних
         (Google Play Services) через явний намір — без <queries> на деяких
         пристроях отримувача не видно і вхід через Google не працює. -->
    <queries>
        <intent>
            <action android:name="androidx.credentials.registry.provider.action.GET_CREDENTIAL" />
        </intent>
    </queries>

    <!--
        1.0.6: поднять лимит кучи.

        Аниме-тегер держит в памяти 167 МБ весов плюс рабочие буферы, и на
        телефоне с 2 ГБ ОЗУ стандартного лимита не хватало: приложение падало
        через несколько секунд после разбора кадра, без сообщения. largeHeap
        поднимает потолок примерно вдвое.

        Это разрешение не создаёт память — её просто становится больше. Если
        её всё равно не хватает, AnimeTagger проверяет свободную память ДО
        загрузки модели и отказывается молча, отдавая «распознавание
        недоступно», вместо того чтобы ронять приложение.

        Комментарий стоит перед тегом, а не внутри: в XML нельзя поставить
        комментарий между атрибутами открывающего тега — файл просто не
        разбирается.
    -->
    <application
        android:name=".AmpsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AMPS">

        <!-- Shares only the `updates` folder of @xml/amps_file_paths with the installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/amps_file_paths" />
        </provider>

        <!--
            1.0.6a: тегер живёт в отдельном процессе.

            Падение внутри ONNX Runtime — нативный SIGSEGV, который не ловится
            ни одним Java-обработчиком и уносит процесс целиком. Когда тегер
            был частью приложения, это означало падение всего приложения.
            Теперь Android убьёт только этот процесс, а основной получит
            отключение связи и напишет «распознавание недоступно».

            exported=false — наружу из процесса никто не ходит, общение
            только внутри приложения через bindService.
        -->
        <service
            android:name=".imaging.TagService"
            android:enabled="true"
            android:exported="false"
            android:process=":tagger" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AMPS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a screenshot straight from the gallery into AMPS -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
