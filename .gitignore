# Build output
build/
*/build/
# Кэш Kotlin-сессии: появляется рядом с проектом и в коммит не годится.
.kotlin/
.gradle/
.gradle-home/
.tmp/
local.properties
*.apk.idsig
*.hprof
captures/
.cxx/
.externalNativeBuild/

# Готовые APK: собираются из исходников, в репозитории им не место.
# Релизы раздаются через GitHub Releases.
dist/

# Тестовые картинки для проверки обратного поиска: скачаны извне,
# чужие и потому не коммитятся.
demo/testset/
demo/testset-ok/

# Модель аниме-тегера. Файл весит 166,8 МБ, а GitHub не принимает в
# репозиторий файлы больше 100 МБ, а квота Git LFS у аккаунта исчерпана.
# Поэтому модель не хранится в git: задача `fetchAnimeTagger` в
# app/build.gradle.kts скачивает её с Hugging Face при сборке и сверяет
# SHA256. В APK она попадает как обычный ассет, то есть в установленном
# приложении модель по-прежнему лежит внутри.
app/src/main/assets/models/*.onnx

# IDE
.idea/
*.iml
.vscode/

# Bridge runtime
bridge/.env
bridge/.cache/
bridge/node_modules/
node_modules/

# Scratch files from tooling and tests
.tmp/
.tmp-*
*.tmp

# OS
Thumbs.db
.DS_Store

# Keystore (never commit signing material)
keystore/
*.jks
*.keystore

# Local data
*.log
